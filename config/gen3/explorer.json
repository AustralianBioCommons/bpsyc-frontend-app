[
  {
    "tabTitle": "Subject",
    "charts": {
      "project_id": {
        "chartType": "horizontalStacked",
        "title": "Projects"
      },
      "species": {
        "chartType": "fullPie",
        "title": "Species"
      },
      "biological_sex": {
        "chartType": "fullPie",
        "title": "Biological Sex"
      },
      "disease_status": {
        "chartType": "horizontalStacked",
        "title": "Disease Status"
      }
    },
    "filters": {
      "tabs": [
        {
          "title": "Subject",
          "fields": [
            "project_id",
            "species",
            "biological_sex",
            "disease_status",
            "biospecimens.sample_class",
            "biospecimens.brain_region_name"
          ]
        }
      ]
    },
    "table": {
      "enabled": true,
      "pageLimit": {
        "limit": 10000
      },
      "fields": [
        "project_id",
        "submitter_subject_id",
        "species",
        "biological_sex",
        "disease_status"
      ],
      "columns": {
        "submitter_subject_id": {
          "sortable": false
        }
      }
    },
    "dropdowns": {
      "download-table": {
        "title": "Download Table",
        "leftIcon": "gen3:download",
        "rightIcon": "gen3:chevron-down",
        "dropdownItems": [
          {
            "enabled": true,
            "type": "data-json",
            "title": "JSON",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-json",
            "actionArgs": {
              "filename": "gen3_datacommon_subjects.json"
            }
          },
          {
            "enabled": true,
            "type": "data-csv",
            "title": "CSV",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-csv",
            "actionArgs": {
              "filename": "gen3_datacommon_data_table.csv"
            }
          }
        ]
      }
    },
    "buttons": [
      {
        "enabled": true,
        "type": "manifest",
        "action": "manifest",
        "title": "Download File Manifest for Subjects",
        "leftIcon": "datafile",
        "rightIcon": "download",
        "fileName": "subject_files_manifest.json",
        "actionArgs": {
          "resourceIndexType": "file",
          "resourceIdField": "object_id",
          "referenceIdFieldInResourceIndex": "_subject_id",
          "referenceIdFieldInDataIndex": "_subject_id",
          "fileFields": ["file_name", "file_size", "md5sum", "object_id"]
        }
      }
    ],
    "loginForDownload": false,
    "guppyConfig": {
      "dataType": "subject",
      "nodeCountTitle": "Subjects",
      "fieldMapping": [
        { "field": "biological_sex", "name": "Biological sex" },
        { "field": "disease_status", "name": "Disease status" },
        { "field": "biospecimens.sample_class", "name": "Sample class" },
        { "field": "biospecimens.brain_region_name", "name": "Brain region" }
      ],
      "manifestMapping": {
        "resourceIndexType": "file",
        "resourceIdField": "object_id",
        "referenceIdFieldInResourceIndex": "_subject_id",
        "referenceIdFieldInDataIndex": "_subject_id"
      },
      "accessibleFieldCheckList": ["auth_resource_path"],
      "accessibleValidationField": "auth_resource_path"
    }
  },
  {
    "tabTitle": "File",
    "charts": {
      "data_type": {
        "chartType": "horizontalStacked",
        "title": "File Type"
      },
      "data_format": {
        "chartType": "horizontalStacked",
        "title": "File Format"
      },
      "source_node": {
        "chartType": "horizontalStacked",
        "title": "Source Node"
      }
    },
    "filters": {
      "tabs": [
        {
          "title": "File",
          "fields": [
            "project_id",
            "data_type",
            "data_format",
            "data_category",
            "source_node",
            "rna_assay_platform",
            "library_type",
            "sequencing_platform",
            "sequencing_facility",
            "protein_assay_platform",
            "analytical_platform"
          ]
        }
      ]
    },
    "table": {
      "enabled": true,
      "fields": [
        "project_id",
        "file_name",
        "file_size",
        "data_format",
        "source_node",
        "_file_id"
      ]
    },
    "buttons": [
      {
        "enabled": true,
        "type": "manifest",
        "title": "Download File Manifest",
        "leftIcon": "datafile",
        "rightIcon": "download",
        "actionArgs": {
          "filename": "file_manifest.json",
          "resourceIndexType": "file",
          "resourceIdField": "object_id",
          "fileFields": ["file_name", "file_size", "md5sum", "object_id"]
        }
      }
    ],
    "loginForDownload": true,
    "guppyConfig": {
      "dataType": "file",
      "fieldMapping": [
        { "field": "object_id", "name": "GUID" },
        { "field": "source_node", "name": "Source node" },
        { "field": "rna_assay_platform", "name": "Platform (RNA assay)" },
        { "field": "protein_assay_platform", "name": "Platform (protein assay)" },
        { "field": "library_type", "name": "Library type" },
        { "field": "sequencing_platform", "name": "Sequencing platform (ENA)" },
        { "field": "sequencing_facility", "name": "Sequencing facility" },
        { "field": "analytical_platform", "name": "Analytical platform (MS)" }
      ],
      "nodeCountTitle": "Files",
      "manifestMapping": {
        "resourceIndexType": "subject",
        "resourceIdField": "_subject_id",
        "referenceIdFieldInResourceIndex": "_subject_id",
        "referenceIdFieldInDataIndex": "_subject_id"
      },
      "accessibleFieldCheckList": ["auth_resource_path"],
      "accessibleValidationField": "auth_resource_path",
      "downloadAccessor": "object_id"
    }
  }
]
